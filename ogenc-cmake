scriptname=$(basename -- "${BASH_SOURCE[0]}")
. "$scriptdir/ogenc-context2"

function usage()
{
  echo "Генератор cmake-файлов для предупреждений или оптимизаций:"
  echo "  $scriptname warnings [g++|clang++]"
  echo "  $scriptname optimize [g++|clang++]"
  echo "Пример:"
  echo "  $scriptname warnings clang++"
}

gen_warnings_cmake() {
    local generator="$1"
    local kind="$2"
    local out="$3"

    # Имя функции: warnings -> warning, optimize -> optimize, errors -> error
    local func="${kind%s}"

    "${generator}" "--help=${kind}" \
        | sed 's/"/`/g' \
        | awk '
            {
                line = $0
                sub(/^[ \t]+/, "", line)

                n = split(line, f, /[ \t]+/)

                if (f[1] ~ /^-/) {
                    if (prev != "") print prev
                    prev = line
                } else if (prev != "") {
                    prev = prev " " line
                }
            }
            END { if (prev != "") print prev }
          ' \
        | awk -v func="${func}" '
            {
                printf("ogenc_%s(%s \"", func, $1)
                for (i = 2; i < NF; i++) printf "%s ", $i
                printf("%s\" ON)\n", $NF)
            }
          ' \
        | sort -u > "${out}"
}

