#!/bin/bash
export LANG=en_US.UTF-8

# Каталог утилит (scripts/) и корень репозитория
scriptdir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
rootdir="$( cd "${scriptdir}/.." >/dev/null 2>&1 && pwd )"
PATH="$PATH:$scriptdir"
config_path="${rootdir}/config"
lists_path="${rootdir}/lists"
cmake_path="${rootdir}/cmake/ogenc/gen"
lists_all_path="${rootdir}/lists/all"
cache_path="${rootdir}/.cache"

mkdir -p "${cache_path}"
mkdir -p "${lists_all_path}"
mkdir -p "${cmake_path}"

current_compiler="${CXX:-}"
if [[ -z "${current_compiler}" ]] && command -v g++ >/dev/null 2>&1; then
  current_compiler=g++
fi
if [[ -z "${current_compiler}" ]] && command -v clang++ >/dev/null 2>&1; then
  current_compiler=clang++
fi

compilers_list_f="${config_path}/compilers.txt"
enabled_list_f="${config_path}/enabled.txt"
disabled_list_f="${config_path}/disabled.txt"
ignored_list_f="${config_path}/ignored.txt"
available_compilers_f="${cache_path}/available_compilers.txt"
default_generator_f="${cache_path}/default_generator.txt"
prefix_list_f="${cache_path}/prefix-list.txt"
generator_options="-Wall -Wextra -Wpedantic -Wformat --pedantic-errors -O3 -Ofast"

log()
{
  local level="$1"
  local msg="$2"
  [[ -z "${VERBOSE:-}" ]] && return 0
  if (( level <= VERBOSE )); then
    echo "$msg"
  fi
  return 0
}

# grep: код 1 (нет совпадений) не считается ошибкой
ogenc_grep()
{
  grep "$@" || {
    local st=$?
    [[ $st -eq 1 ]] && return 0
    return "$st"
  }
}

# Строка g++ -Q --help: конкретный уровень (-Wfoo -> -Wfoo=1) и число у <…>.
# Правая колонка с другим флагом (-Wcomments -> -Wcomment) левый токен не заменяет.
# Одно слово (уже готовый список) проходит как есть.
ogenc_concrete_flags()
{
  awk '
    function placeholder_stem(opt, name) {
      name = opt
      if (sub(/=<[^>]*>$/, "", name)) return name
      name = opt
      if (sub(/=\[[^]]*\]$/, "", name)) return name
      name = opt
      if (sub(/<[^>]*>$/, "", name)) return name
      name = opt
      if (sub(/\[[^]]*\]$/, "", name)) return name
      return ""
    }
    function stem_of(flag, s) {
      s = flag
      sub(/=.*$/, "", s)
      return s
    }
    function is_flag(val) {
      return val ~ /^-[A-Za-z]/ || val ~ /^--/
    }
    function consider(opt, val, name, base) {
      if (opt !~ /^-/ || opt ~ /^-Wno-/) return
      if (is_flag(val)) {
        name = placeholder_stem(opt)
        base = (name != "" ? name : opt)
        # -Warray-bounds -> -Warray-bounds=1, -Wfoo<0,2> -> -Wfoo=1
        if (stem_of(val) == base && val != base) {
          from_flag[base] = 1
          keep[val] = 1
          return
        }
        if (opt ~ /-$/ || opt ~ /[<[]/ || opt ~ /=$/) return
        keep[opt] = 1
        return
      }
      name = placeholder_stem(opt)
      if (name != "" && val ~ /^[0-9]+$/) {
        pending_name[++np] = name
        pending_val[np] = val
        return
      }
      if (opt ~ /-$/ && val == "") return
      if (name != "" || opt ~ /=$/ || opt ~ /[<[]/) return
      keep[opt] = 1
    }
    {
      line = $0
      sub(/^[ \t]+/, "", line)
      if (line == "") next
      n = split(line, f, /[ \t]+/)
      opt = f[1]
      val = ""
      if (n >= 2 && f[2] !~ /^\[/) val = f[2]
      opts[++nrows] = opt
      vals[nrows] = val
    }
    END {
      for (i = 1; i <= nrows; i++) consider(opts[i], vals[i])
      for (i = 1; i <= np; i++) {
        if (from_flag[pending_name[i]]) continue
        keep[pending_name[i] "=" pending_val[i]] = 1
      }
      for (flag in keep) print flag
    }
  '
}

# Строка enabled.txt с тем же ключом до «=» заменяет значение из help.
ogenc_apply_enabled_values()
{
  local opt stem
  declare -A by_stem=()
  if [[ -s "${enabled_list_f}" ]]; then
    while IFS= read -r opt || [[ -n "${opt}" ]]; do
      [[ -z "${opt}" || "${opt}" == \#* ]] && continue
      [[ "${opt}" == *=* ]] || continue
      stem=${opt%%=*}
      by_stem["${stem}"]=${opt}
    done < "${enabled_list_f}"
  fi
  while IFS= read -r opt || [[ -n "${opt}" ]]; do
    [[ -z "${opt}" ]] && continue
    if [[ "${opt}" == *=* ]]; then
      stem=${opt%%=*}
      if [[ -n "${by_stem[${stem}]:-}" ]]; then
        opt=${by_stem[${stem}]}
      fi
    fi
    printf '%s\n' "${opt}"
  done
}

ogenc_load_default_generator()
{
  if [[ -z "${default_generator:-}" ]]; then
    default_generator="${CXXGEN:-}"
  fi
  if [[ -z "${default_generator:-}" && -f "${default_generator_f}" ]]; then
    default_generator="$(cat "${default_generator_f}")"
  fi
}

# Обновить кэш компиляторов только если его ещё нет (не на каждом этапе)
ogenc_ensure_compilers()
{
  if [[ ! -f "${available_compilers_f}" || ! -s "${prefix_list_f}" ]]; then
    "${scriptdir}/ogenc-compilers" update
  fi
  ogenc_load_default_generator
}
