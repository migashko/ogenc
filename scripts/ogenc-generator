#!/bin/bash
set -euo pipefail

scriptdir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
scriptname=$(basename -- "${BASH_SOURCE[0]}")
. "$scriptdir/ogenc-context1"
ogenc_ensure_compilers

usage()
{
  echo "Генератор списков предупреждений или оптимизаций:"
  echo "  $scriptname warnings [целевой_компилятор [компилятор-генератор [опции-генератора ] ] ]"
  echo "  $scriptname optimize  [целевой_компилятор [компилятор-генератор [опции-генератора ] ] ]"
  echo "Пример:"
  echo "  $scriptname warnings clang++ g++ \"-W -Wall -Wextra -Wformat -Wpedantic\" "
}

if [[ -z "${1:-}" ]] || { [[ "$1" != "warnings" ]] && [[ "$1" != "optimize" ]]; }; then
  usage
  exit 1
fi

specific=$1

[[ -n "${2:-}" ]] && current_compiler="$2"
[[ -n "${3:-}" ]] && default_generator="$3"
[[ -n "${4:-}" ]] && generator_options="$4"

comp_name=$(ogenc-versions name "${current_compiler}")
raw_options_list_f="${cache_path}/raw-${comp_name}-${specific}.txt"
all_options_list_f="${cache_path}/all-${comp_name}-${specific}.txt"
fail_options_list_f="${cache_path}/fail-${comp_name}-${specific}.txt"
options_list_f="${cache_path}/${specific}-${comp_name}.txt"
probe_dir="${cache_path}/probe"
probe_err="${cache_path}/probe-stderr.txt"
mkdir -p "${probe_dir}"

raw_from_help=0
if [[ -n "${default_generator:-}" && -x "${default_generator}" ]]; then
  gen_base=$(basename "${default_generator}")
  if [[ "${gen_base}" == g++ || "${gen_base}" == g++-* ]]; then
    raw_from_help=1
  fi
fi

if [[ "${raw_from_help}" == 1 ]]; then
  # shellcheck disable=SC2086
  read -r -a gen_opts <<< "${generator_options}"
  # Без -x c++ справка не помечает [enabled] то, что -Wall уже включает для C++
  # (-Wreorder, -Wdelete-non-virtual-dtor). -x c++ без файла даёт no input files.
  if [[ "${specific}" == "warnings" ]]; then
    log 0 "Генерирую ${specific}: ${default_generator} ${generator_options} -x c++ test.cpp -Q --help=${specific} для ${current_compiler} ..."
    "${default_generator}" "${gen_opts[@]}" -x c++ "${scriptdir}/test.cpp" -Q "--help=${specific}" | ogenc_grep -v "\[enabled\]" > "${raw_options_list_f}"
  else
    log 0 "Генерирую ${specific}: ${default_generator} ${generator_options} -Q --help=${specific} для ${current_compiler} ..."
    "${default_generator}" "${gen_opts[@]}" -Q "--help=${specific}" | ogenc_grep -v "\[enabled\]" > "${raw_options_list_f}"
  fi
else
  # clang, в том числе Apple clang, не понимает --help=warnings. Без g++
  # пробуем флаги, которые уже есть в lists/all (это полные списки, не слои lists/).
  log 0 "Генерирую ${specific} для ${current_compiler} из lists/all (нет g++ --help) ..."
  shopt -s nullglob
  known_lists=( "${lists_all_path}/${specific}-"*.txt )
  shopt -u nullglob
  if (( ${#known_lists[@]} > 0 )); then
    sort -u "${known_lists[@]}" > "${raw_options_list_f}"
  else
    : > "${raw_options_list_f}"
  fi
fi
: > "${all_options_list_f}"
: > "${fail_options_list_f}"

norm_options_list_f="${cache_path}/norm-${comp_name}-${specific}.txt"
ogenc_concrete_flags < "${raw_options_list_f}" \
  | ogenc_apply_enabled_values | sort -u > "${norm_options_list_f}"

# Компилятор принял флаг: ненулевой код или любой stderr — отказ.
option_accepted() {
  local opt="$1"
  if (
    cd "${probe_dir}"
    "${current_compiler}" "${opt}" "${scriptdir}/test.cpp" -Werror -o probe
  ) >/dev/null 2>"${probe_err}"; then
    [[ "$(wc -l < "${probe_err}" | tr -d ' ')" == "0" ]]
    return
  fi
  return 1
}

# В help есть ровно этот токен (-Warray-bounds), а не -Warray-bounds=<0,2>.
help_has_flag() {
  local stem="$1"
  awk -v s="${stem}" '
    {
      line = $0
      sub(/^[ \t]+/, "", line)
      if (line == "") next
      split(line, f, /[ \t]+/)
      if (f[1] == s) { found = 1; exit }
    }
    END { exit found ? 0 : 1 }
  ' "${raw_options_list_f}"
}

while IFS="" read -r opt
do
  [[ -z "${opt}" ]] && continue
  [[ "${opt}" == -* ]] || continue
  [[ "${opt}" == -Wno-* ]] && continue

  chosen=""
  if option_accepted "${opt}"; then
    chosen="${opt}"
  elif [[ "${opt}" == *=* ]]; then
    # clang не знает -Warray-bounds=1, но знает -Warray-bounds.
    stem="${opt%%=*}"
    if [[ -n "${stem}" && "${stem}" != "${opt}" ]] && help_has_flag "${stem}" && option_accepted "${stem}"; then
      chosen="${stem}"
      log 2 "OK: ${stem} (вместо ${opt})"
    fi
  fi

  if [[ -n "${chosen}" ]]; then
    [[ "${chosen}" == "${opt}" ]] && log 2 "OK: ${opt}"
    echo "${chosen}" >> "${all_options_list_f}"
  else
    log 1 "ОШИБКА ${current_compiler}: ${opt}"
    echo "${opt}" >> "${fail_options_list_f}"
  fi
done < "${norm_options_list_f}"

log 2 "фильтр ignored.txt → ${options_list_f}"
ogenc_grep -vwF -f "${ignored_list_f}" "${all_options_list_f}" | sort > "${options_list_f}"
log 2 "cp ${options_list_f} ${lists_all_path}"
cp "${options_list_f}" "${lists_all_path}/"
log 1 "Готово"
